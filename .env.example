# ============================================================
#  Plantilla de variables de entorno
#  Copia este archivo como ".env" solo para pruebas locales.
#  En Render NO se sube: las variables se configuran en el
#  panel del servicio (o las inyecta render.yaml).
# ============================================================

# Rol de ESTE servicio: 'preguntona' (inicia el debate) o 'respondona'
ROL=preguntona

# URL PUBLICA del otro servicio (el otro rol).
# En Render es: https://<nombre-del-otro-servicio>.onrender.com
PEER_URL=https://tu-servicio-vecino.onrender.com

# Base de datos compartida (la MISMA en los dos servicios)
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/debate-ia

# API key de Gemini del rol de ESTE servicio
GEMINI_API_KEY_PREGUNTONA=tu-api-key-de-preguntona
GEMINI_API_KEY_RESPONDONA=tu-api-key-de-respondona
# Respaldo opcional (se usa solo si falta la key del rol)
GEMINI_API_KEY=

# Puerto local (en Render lo asigna la plataforma: 10000)
PORT=3000
